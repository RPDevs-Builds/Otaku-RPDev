<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.otaku.rpdev" version="1.2.1" name="Otaku RPDev Background Service" provider-name="RPDev">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.beautifulsoup4"/>
    <import addon="script.module.soupsieve" optional="true"/>
    <import addon="script.module.web-pdb" optional="true"/>
    <import addon="script.module.inputstreamhelper" optional="true"/>
    <import addon="script.module.pyqrcode"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.python.module" library="resources/lib"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Background maintenance, database sync, and service settings for Otaku RPDev</summary>
    <description lang="en">Persistent background OAuth refresh, offline mappings/metadata sync, multipage pre-caching, cache/SQLite PRAGMA tuning, solvers, network settings, and diagnostics for Otaku RPDev.</description>
    <platform>all</platform>
    <reuselanguageinvoker>false</reuselanguageinvoker>
    <license>GPL-3.0</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
      <clearlogo>logo.png</clearlogo>
      <poster>poster.png</poster>
    </assets>
  </extension>
</addon>
