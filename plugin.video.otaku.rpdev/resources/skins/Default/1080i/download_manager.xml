<window type="dialog">
    <controls>
        <!-- Background Texture -->
        <control type="image">
            <texture>white.png</texture>
            <colordiffuse>FF000000</colordiffuse>
        </control>
        <control type="list" id="1100">
        </control>
        <!-- Fanart -->
        <control type="image">
            <top>0</top>
            <left>0</left>
            <width>1920</width>
            <height>1080</height>
            <texture background="true">fanart.png</texture>
        </control>

        <!-- Background -->
        <control type="image">
            <top>0</top>
            <left>0</left>
            <width>1920</width>
            <height>1080</height>
            <texture background="true">white.png</texture>
            <colordiffuse>CC000000</colordiffuse>
        </control>

        <!-- Buttons -->
        <control type="grouplist" id="2000">
            <top>150</top>
            <left>1300</left>
            <width>500</width>
            <onleft>17</onleft>
            <itemgap>20</itemgap>
            <control type="button" id="3100">
                <label>Clear Completed</label>
                <height>70</height>
                <width>500</width>
                <aligny>center</aligny>
                <align>center</align>
                <font>font14</font>
                <texturenofocus colordiffuse="40FFFFFF">white.png</texturenofocus>
                <texturefocus colordiffuse="FF00BFFF">white.png</texturefocus>
            </control>
            <control type="button" id="3101">
                <label>Close</label>
                <height>70</height>
                <width>500</width>
                <aligny>center</aligny>
                <align>center</align>
                <font>font14</font>
                <texturenofocus colordiffuse="40FFFFFF">white.png</texturenofocus>
                <texturefocus colordiffuse="FFFF6B6B">white.png</texturefocus>
            </control>
        </control>

        <!-- Scrollbar  -->
        <control type="scrollbar" id="17">
            <left>1250</left>
            <top>150</top>
            <width>20</width>
            <height>838</height>
            <visible>true</visible>
            <pulseonselect>no</pulseonselect>
            <orientation>vertical</orientation>
            <showonepage>false</showonepage>
            <onright>2000</onright>
            <onleft>1000</onleft>
        </control>

        <!-- Download List -->
        <control type="list" id="1000">
            <viewtype label="Downloads">list</viewtype>
            <left>80</left>
            <top>150</top>
            <width>1170</width>
            <height>920</height>
            <orientation>vertical</orientation>
            <focusposition>1</focusposition>
            <pagecontrol>17</pagecontrol>
            <onright>17</onright>

            <itemlayout height="120">
                <control type="image">
                    <visible>true</visible>
                    <texture background="true">white.png</texture>
                    <colordiffuse>AA2e2d32</colordiffuse>
                </control>
                <control type="label">
                    <top>15</top>
                    <left>20</left>
                    <width>1130</width>
                    <height>35</height>
                    <font>font13</font>
                    <textcolor>66FFFFFF</textcolor>
                    <shadowcolor>dimgrey</shadowcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <top>65</top>
                    <left>20</left>
                    <width>400</width>
                    <height>30</height>
                    <aligny>center</aligny>
                    <textcolor>66FFFFFF</textcolor>
                    <shadowcolor>dimgrey</shadowcolor>
                    <font>font12</font>
                    <label>$INFO[ListItem.Property(item.info.status)] - $INFO[ListItem.Property(item.info.progress)]%</label>
                </control>
            </itemlayout>
            <focusedlayout height="120">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1170</width>
                    <height>116</height>
                    <texture border="4" background="true">white.png</texture>
                    <colordiffuse>FF00BFFF</colordiffuse>
                </control>
                <control type="image">
                    <left>2</left>
                    <top>2</top>
                    <width>1166</width>
                    <height>112</height>
                    <texture background="true">white.png</texture>
                    <colordiffuse>FF222834</colordiffuse>
                </control>
                <control type="label">
                    <top>15</top>
                    <left>20</left>
                    <width>1130</width>
                    <height>35</height>
                    <font>font14</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <shadowcolor>dimgrey</shadowcolor>
                    <align>left</align>
                    <aligny>center</aligny>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
                <control type="label">
                    <top>60</top>
                    <left>20</left>
                    <width>320</width>
                    <height>25</height>
                    <aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>Progress: [COLOR deepskyblue]$INFO[ListItem.Property(item.info.progress)]%[/COLOR]</label>
                </control>
                <control type="label">
                    <top>88</top>
                    <left>20</left>
                    <width>320</width>
                    <height>25</height>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <font>font12</font>
                    <label>ETA: [COLOR deepskyblue]$INFO[ListItem.Property(item.info.eta)][/COLOR]</label>
                </control>
                <control type="label">
                    <top>60</top>
                    <left>380</left>
                    <width>400</width>
                    <height>25</height>
                    <aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align>
                    <label>Download: [COLOR deepskyblue]$INFO[ListItem.Property(item.info.downloaded)]/$INFO[ListItem.Property(item.info.filesize)][/COLOR]</label>
                </control>
                <control type="label">
                    <top>88</top>
                    <left>380</left>
                    <width>400</width>
                    <height>25</height>
                    <aligny>center</aligny>
                    <font>font12</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>left</align>
                    <label>Speed: [COLOR deepskyblue]$INFO[ListItem.Property(item.info.speed)][/COLOR]</label>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
